<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sign in to your session-based Gen Z to-do list for Experiment 12-B.">
  <title>Sign in · Sidequest — Experiment 12-B</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body data-theme="<%= theme %>">
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/login" aria-label="Sidequest home"><span class="brand-mark" aria-hidden="true">✳</span> sidequest<span class="brand-period">.</span></a>
      <p class="topbar-note">EXP-12B <span>·</span> backend lab</p>
      <div class="topbar-actions">
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to day theme">☀️ <span>Day mode</span></button>
        <a class="nav-link" href="/register">Create account <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>

  <main class="auth-layout">
    <section class="auth-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> your brain has 37 tabs open</p>
        <h1 id="hero-title">Make your<br><span class="headline-accent">next move</span><br>the main thing.</h1>
        <p class="hero-description">A tiny task HQ for your big ideas, little errands and “I’ll do it later” list. Sign in and get one thing moving.</p>
        <div class="sticker-row" aria-label="App highlights">
          <span class="sticker sticker-lime">one thing at a time</span>
          <span class="sticker sticker-pink">your list, your session</span>
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true">
        <span class="orbit-ring"></span><span class="orbit-spark spark-one">✦</span><span class="orbit-spark spark-two">✳</span>
        <div class="orbit-note"><span>tiny task</span><strong>big energy</strong><i>↗</i></div>
        <span class="orbit-caption">LESS SCROLL · MORE SOUL</span>
      </div>
      <div class="hero-footnote"><span>✳</span> built for the “let me just write that down” moments</div>
    </section>

    <section class="auth-card" aria-labelledby="form-title">
      <div class="card-topline"><span class="card-index">01 / SIGN IN</span><span class="card-emoji" aria-hidden="true">🪩</span></div>
      <h2 id="form-title">You’re so back.</h2>
      <p class="card-intro">Pick up where your current session left off.</p>

      <% if (successMessage) { %><div class="notice notice-success" role="status"><%= successMessage %></div><% } %>
      <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>

      <form action="/login" method="POST" class="auth-form">
        <label for="username">Username</label>
        <input id="username" type="text" name="username" value="<%= username %>" placeholder="your username" autocomplete="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9._-]{3,32}" required>

        <label for="password">Password</label>
        <input id="password" type="password" name="password" placeholder="your password" autocomplete="current-password" minlength="8" maxlength="128" required>

        <button class="button button-primary form-submit" type="submit">Let me in <span aria-hidden="true">↗</span></button>
      </form>
      <p class="account-switch">New here? <a href="/register">Make an account <span aria-hidden="true">↗</span></a></p>
      <p class="session-hint"><span aria-hidden="true">◉</span> Session-only tasks · logs out when you leave</p>
    </section>
  </main>

  <footer class="site-footer"><span>EXPERIMENT 12-B</span><span>express sessions / personal task manager</span><span>GOPAL AGGARWAL · SAP ID 590018885</span></footer>
</body>
</html>
